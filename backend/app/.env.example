# ==================================================
# ArogyaPlus Healthcare - Backend Environment Variables
# Copy this file to backend/app/.env and fill in real values.
# ==================================================

# --- Database ---
DATABASE_URL=postgresql://arogyaplus:arogyaplus@localhost:5432/arogyaplus

# --- JWT Auth ---
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Single Admin Account (used by seed script) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@arogyaplus.health
ADMIN_PASSWORD=change-this-strong-password

# --- WhatsApp Business API (Meta Cloud API - configure later) ---
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DESTINATION_NUMBER=

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
